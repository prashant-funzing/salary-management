#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")
  system! "npm", "ci", "--prefix", "frontend"

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  puts "\n== Seeding synthetic employees and salary history =="
  system! "bin/rails db:seed"
  puts "\n== Building React =="
  system! "npm", "run", "build", "--prefix", "frontend"
  puts "\nSetup complete. Run: bin/rails server -p 3100"
  puts "Open http://localhost:3100 (login details are in README.md)."
end
